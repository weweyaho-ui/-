let currentPM = 'الدفع عند الاستلام';
let tempImages = [];
let tempVideo = null;

/* Seed demo products if empty */
if (products.length === 0) {
  products = [
    { id:1, name:'آيفون 15 برو ماكس', cat:'جوالات', price:750000, oldPrice:850000, desc:'شاشة 6.7 بوصة، كاميرا 48MP، معالج A17 Pro، ذاكرة 256GB', images:[], video:null, date:Date.now() },
